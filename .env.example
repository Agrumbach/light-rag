### LightRAG Konfiguration
### Quelle: https://github.com/HKUDS/LightRAG
### Kopiere diese Datei als .env und trage deine Werte ein

###########################
### Server Configuration
###########################
HOST=0.0.0.0
PORT=9621
WEBUI_TITLE='LightRAG'
WEBUI_DESCRIPTION='Graph Based RAG System'

###########################
### Authentication
###########################
# API-Key: schützt API-Endpunkte (Bearer Token)
# In der WebUI unter "Configure" eingeben
LIGHTRAG_API_KEY=your_api_key_here

# WebUI Login: Benutzerkonten für Login-Formular
# Format: benutzername:passwort,benutzer2:passwort2
AUTH_ACCOUNTS=admin:your_password_here

# Geheimer Schlüssel für JWT-Token-Signierung (mindestens 32 Zeichen, zufällig)
TOKEN_SECRET=your_random_secret_min_32_chars_here

###########################################################################
### LLM Configuration
### LLM_BINDING type: openai, ollama, azure_openai, gemini, aws_bedrock
###########################################################################
LLM_BINDING=azure_openai
LLM_BINDING_HOST=https://your-resource.openai.azure.com/
LLM_BINDING_API_KEY=your_azure_openai_api_key_here
LLM_MODEL=your_deployment_name_here
AZURE_OPENAI_API_VERSION=2025-01-01-preview

### OpenAI (auskommentiert)
# LLM_BINDING=openai
# LLM_BINDING_HOST=https://api.openai.com/v1
# LLM_BINDING_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

### Ollama (lokales Modell) - LLM_BINDING_HOST anpassen wenn Ollama läuft
# LLM_BINDING=ollama
# LLM_BINDING_HOST=http://host.docker.internal:11434
# LLM_MODEL=llama3.2
# OLLAMA_LLM_NUM_CTX=32768

#######################################################################################
### Embedding Configuration
### EMBEDDING_BINDING: openai, ollama, azure_openai, jina, aws_bedrock
#######################################################################################
EMBEDDING_BINDING=azure_openai
EMBEDDING_BINDING_HOST=https://your-resource.openai.azure.com/
EMBEDDING_BINDING_API_KEY=your_azure_openai_api_key_here
EMBEDDING_MODEL=your_embedding_deployment_name_here
EMBEDDING_DIM=1536
EMBEDDING_TOKEN_LIMIT=8192

### OpenAI Embedding (auskommentiert)
# EMBEDDING_BINDING=openai
# EMBEDDING_BINDING_HOST=https://api.openai.com/v1
# EMBEDDING_BINDING_API_KEY=your_openai_api_key_here
# EMBEDDING_MODEL=text-embedding-3-large

### Ollama Embedding
# EMBEDDING_BINDING=ollama
# EMBEDDING_BINDING_HOST=http://host.docker.internal:11434
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIM=768
# OLLAMA_EMBEDDING_NUM_CTX=8192

############################
### Storage: PostgreSQL + pgvector + Apache AGE
############################
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=PGGraphStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=your_postgres_user_here
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=lightrag
POSTGRES_DATABASE=lightrag

### JSON/NetworkX (nur für Tests)
# LIGHTRAG_KV_STORAGE=JsonKVStorage
# LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
# LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
# LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage

########################################
### Document processing
########################################
ENABLE_LLM_CACHE_FOR_EXTRACT=true
SUMMARY_LANGUAGE=German

###############################
### Concurrency
###############################
MAX_ASYNC=4
MAX_PARALLEL_INSERT=2

###########################
### Reranking (deaktiviert)
###########################
RERANK_BINDING=null
